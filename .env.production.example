# Copy to .env on the server (never commit the real file).
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# --- Firebase (server / Admin REST) ---
FIREBASE_PROJECT_ID=true-furniture-s
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@true-furniture-s.iam.gserviceaccount.com
# Keep the literal \n escapes from the service-account JSON, wrapped in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Cloudinary (images / 3D models) ---
CLOUDINARY_CLOUD_NAME=dpybzn1oa
CLOUDINARY_API_KEY=832235724692268
CLOUDINARY_API_SECRET=your_cloudinary_secret