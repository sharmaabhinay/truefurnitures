{
  "schema_version": 1,
  "events": {
    "project.coupon_applied": {
      "event_schema_version": 1,
      "description": "A customer's coupon passed validation and was applied to the cart.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "item_count": {
            "type": "number"
          }
        }
      }
    },
    "project.coupon_rejected": {
      "event_schema_version": 1,
      "description": "A coupon a customer tried to apply was rejected or could not be checked.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "not_eligible",
              "check_failed"
            ]
          }
        }
      }
    },
    "project.homepage_video_viewed": {
      "event_schema_version": 1,
      "description": "The homepage video actually starts playing in the visible viewport, once per mounted video; loops and pause/resume do not add views.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "video_id",
          "placement"
        ],
        "properties": {
          "video_id": {
            "type": "string"
          },
          "placement": {
            "type": "string",
            "enum": [
              "homepage"
            ]
          }
        }
      }
    },
    "project.product_video_played": {
      "event_schema_version": 1,
      "description": "A storefront product video actually starts playing, once per video mount; excludes admin previews and pause/resume repeats.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "video_id",
          "placement"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "video_id": {
            "type": "string"
          },
          "placement": {
            "type": "string",
            "enum": [
              "product",
              "vertical"
            ]
          }
        }
      }
    },
    "project.product_video_preview_opened": {
      "event_schema_version": 1,
      "description": "A shopper opens a product YouTube or Instagram player. This is a preview request, not confirmed third-party playback.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "video_id",
          "provider",
          "placement"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "video_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "youtube",
              "instagram"
            ]
          },
          "placement": {
            "type": "string",
            "enum": [
              "product",
              "vertical"
            ]
          }
        }
      }
    },
    "project.purchase_completed": {
      "event_schema_version": 1,
      "description": "Checkout placed the customer's orders, with or without a coupon.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_count",
          "used_coupon"
        ],
        "properties": {
          "order_count": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "discount": {
            "type": "number"
          },
          "used_coupon": {
            "type": "boolean"
          },
          "coupon_code": {
            "type": "string"
          }
        }
      }
    }
  }
}
