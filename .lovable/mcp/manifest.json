{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://securetoken.google.com/true-furniture-s",
    "accepted_audiences": [
      "true-furniture-s"
    ]
  },
  "mcp": {
    "server": {
      "name": "true-furniture-s",
      "version": "0.1.0",
      "title": "True Furniture's"
    },
    "tools": [
      {
        "name": "search_sofas",
        "title": "Search sofas",
        "description": "Search the published True Furniture's sofa catalogue by name or keyword. Returns slug, name, tagline, base price and lead time.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Optional keyword to match against sofa name or tagline.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum results to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_sofa",
        "title": "Get sofa details",
        "description": "Fetch the full detail of one published sofa by its slug: description, features, dimensions, materials, pricing and delivery time.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Sofa slug, e.g. 'aurora-three-seater'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "List my orders",
        "description": "List the signed-in customer's own sofa orders with status, totals, deposit paid, balance due and expected delivery date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum orders to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_my_order",
        "title": "Get my order",
        "description": "Fetch one of the signed-in customer's own orders by order number, including the configured sofa, fabric, size, add-ons and its status history timeline.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "order_number": {
              "type": "string",
              "minLength": 1,
              "description": "Order number, e.g. 'TF-1042'."
            }
          },
          "required": [
            "order_number"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_designs",
        "title": "List my saved designs",
        "description": "List the signed-in customer's saved sofa configurations from the 3D designer, including the chosen options and share token.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum designs to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
